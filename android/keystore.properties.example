# Copy this file to android/keystore.properties locally. Do not commit the copy.
# The values belong to the application owner and are required only for a Play-ready release build.
ARICIMAP_RELEASE_STORE_FILE=/absolute/path/to/aricimap-release.jks
ARICIMAP_RELEASE_STORE_PASSWORD=replace-with-keystore-password
ARICIMAP_RELEASE_KEY_ALIAS=replace-with-key-alias
ARICIMAP_RELEASE_KEY_PASSWORD=replace-with-key-password
